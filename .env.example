# ===========================================
# ENVIRONMENTS
# ===========================================
# Copie este arquivo para .env.local e .env.prod
# Use --env local (default) ou --env prod para escolher:
#
#   python gui.py --env local    (ou simplesmente: python gui.py)
#   python gui.py --env prod
#   python main.py --gui --env prod
#
# ===========================================

# ===========================================
# LICENSE (OBRIGATORIO)
# ===========================================
# Sua API key/license key (obtida no dashboard apos pagamento)
# Formato: tm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEMETRY_API_KEY=tm_sua-license-key-aqui

# ===========================================
# CHARACTER (OBRIGATORIO)
# ===========================================
# UUID do character cadastrado no dashboard
# Voce precisa adicionar o character no app primeiro
# Depois copiar o ID dele para ca
CHARACTER_ID=uuid-do-character-aqui

# ===========================================
# API CONFIG
# ===========================================
# Local:
#   TELEMETRY_API_URL=http://localhost:3333
#   TELEMETRY_WS_URL=ws://localhost:3333/ws
#
# Producao:
#   TELEMETRY_API_URL=https://api.tibiaeye.com.br
#   TELEMETRY_WS_URL=wss://api.tibiaeye.com.br/ws

TELEMETRY_API_URL=http://localhost:3333
TELEMETRY_WS_URL=ws://localhost:3333/ws
TELEMETRY_ENABLED=true
TELEMETRY_FLUSH_INTERVAL=5.0
